# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Conda
*.conda

# Weights & Biases
wandb/

# Secrets — never commit (WANDB_API_KEY etc.)
.secrets/

# Logs
logs/
slurm-*.out

# Checkpoints and run artefacts (large binaries — not committed)
checkpoints/

# Data (actual data lives on Sol — only symlinks committed)
data/raw/*
data/processed/*
data/synthetic/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep

# Brainstorming session files
.superpowers/

# Claude Code. The project setup (.claude/ and CLAUDE.md) is tracked, and this repo
# is public: never put a key, token or private note in those files. Only local,
# per-machine state is ignored.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/skills.pre-merge-backup/
graphify-out/

# Reflection / scratch notes
reflection-notes-*.md

# Project management and session docs (not for public repo)
PLANNING.md
MEMORY.md
session-tail.md
.session-next
docs/figures/
docs/archive/
docs/superpowers/
docs/progress_notes.md

# Compiled C extensions
*.so

# Vim swap files
*.swp

# macOS
.DS_Store

# VS Code
.vscode/
# Playwright CLI output (may contain credentials)
.playwright-cli/
.playwright/

# Local kanban scratch file (synced to GitHub issues by the dashboard)
phase-05-kanban.md

# One-time backup written by the dashboard kanban sync
*.pre-sync.bak

# Local stakeholder progress reports (written by the progress-report skill)
/reports/

# Local symlink to the repo-root setup script
dashboard/setup_env.sh

# Local manual test checklist for the dashboard
dashboard/MANUAL_TESTS.md
